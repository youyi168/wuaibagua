# GitHub Actions 构建脚本 - 推荐配置
# 基于全面兼容性分析后的最佳实践
# 生成时间：2026-03-29

name: Build Android APK

on:
  push:
    branches: [ main, master, dev ]
    tags:
      - 'v*'
  pull_request:
    branches: [ main, master, dev ]
  workflow_dispatch:
    inputs:
      build_type:
        description: 'Build type'
        required: true
        default: 'debug'
        type: choice
        options:
          - debug
          - release

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-22.04
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    # 【推荐】统一使用 Python 3.11 (与 buildozer.spec 一致)
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'
        cache: 'pip'
    
    - name: Cache Buildozer Dependencies
      uses: actions/cache@v4
      id: cache-buildozer
      with:
        path: |
          ~/.buildozer/android/platform
          ~/.buildozer/android/packages
          ~/.gradle/caches
        key: ${{ runner.os }}-buildozer-${{ hashFiles('buildozer.spec') }}
        restore-keys: |
          ${{ runner.os }}-buildozer-
    
    - name: Clear Buildozer Cache (if needed)
      if: github.event.inputs.build_type == 'clean'
      run: |
        echo "=== Clearing all caches ==="
        rm -rf ~/.buildozer
        rm -rf .buildozer
        echo "✓ Cache cleared"
    
    # 【推荐】使用最新稳定版构建工具
    - name: Install Buildozer
      run: |
        pip3 install --upgrade pip
        pip3 install Cython==3.0.10      # 升级到 3.0.x，性能提升 30%
        pip3 install buildozer==1.6.0    # 升级到 1.6.0，支持 SDK 34
        pip3 install virtualenv
    
    - name: Install system dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y \
          git zip unzip \
          autoconf libtool pkg-config \
          zlib1g-dev libncurses5-dev libncursesw5-dev liblzma-dev \
          python3-pip python3-venv \
          libffi-dev libssl-dev \
          automake cmake \
          libgtk-3-dev
    
    - name: Configure Git and Network
      run: |
        git config --global http.sslVerify true
        git config --global http.postBuffer 524288000
        git config --global http.lowSpeedLimit 1000
        git config --global http.lowSpeedTime 300
    
    - name: Build APK
      id: build_apk
      run: |
        export PATH="$HOME/.local/bin:$PATH"
        export PYTHONHTTPSVERIFY=1
        export PIP_CERT=/etc/ssl/certs/ca-certificates.crt
        
        MAX_RETRIES=3
        RETRY_COUNT=0
        BUILD_SUCCESS=false
        
        while [ $RETRY_COUNT -lt $MAX_RETRIES ] && [ "$BUILD_SUCCESS" = "false" ]; do
          echo "=== Build attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES ==="
          if buildozer android debug 2>&1 | tee build.log; then
            BUILD_SUCCESS=true
            echo "=== Build successful! ==="
          else
            RETRY_COUNT=$((RETRY_COUNT + 1))
            if [ $RETRY_COUNT -lt $MAX_RETRIES ]; then
              echo "=== Build failed, retrying in 30 seconds... ==="
              sleep 30
            fi
          fi
        done
        
        if [ "$BUILD_SUCCESS" = "false" ]; then
          exit 1
        fi
      timeout-minutes: 90
    
    - name: Find and copy APK
      id: find_apk
      run: |
        echo "=== Searching for APK files ==="
        mkdir -p release
        
        # 显示目录结构
        echo "=== .buildozer structure ==="
        find .buildozer -type d -name "bin" 2>/dev/null | head -5
        
        # 查找所有 APK
        echo "=== All APK files ==="
        find .buildozer -name "*.apk" -type f 2>/dev/null
        
        # 使用最新修改时间查找 APK
        LATEST_APK=$(find .buildozer -name "*.apk" -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
        
        # 备用方案
        if [ -z "$LATEST_APK" ] || [ ! -f "$LATEST_APK" ]; then
          echo "Trying alternative paths..."
          for path in \
            ".buildozer/android/bin/*.apk" \
            ".buildozer/android/platform/build-*/dists/*/build/outputs/apk/*/debug/*.apk" \
            ".buildozer/android/platform/build-*/dists/**/build/outputs/apk/**/*.apk"; do
            FOUND=$(ls -t $path 2>/dev/null | head -1)
            if [ -n "$FOUND" ] && [ -f "$FOUND" ]; then
              LATEST_APK="$FOUND"
              echo "Found APK via alternative path: $LATEST_APK"
              break
            fi
          done
        fi
        
        if [ -n "$LATEST_APK" ] && [ -f "$LATEST_APK" ]; then
          echo "Found latest APK: $LATEST_APK"
          ls -lh "$LATEST_APK"
          cp -v "$LATEST_APK" release/
          echo "apk_count=1" >> $GITHUB_OUTPUT
          echo "✅ Success"
        else
          echo "::error::No APK found"
          echo "=== Debug info ==="
          find .buildozer -name "*.apk" -ls 2>/dev/null || true
          exit 1
        fi
    
    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: woaibagua-apk-${{ github.run_number }}
        path: release/*.apk
        if-no-files-found: error
        retention-days: 30
    
    - name: Upload build logs
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: build-logs-${{ github.run_number }}
        path: build.log
        retention-days: 7
