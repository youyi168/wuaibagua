<?xml version="1.0" encoding="utf-8"?>
<!--
    自定义 AndroidManifest.xml 覆盖配置
    用于禁用 Vulkan，强制使用 OpenGL ES 2.0
    解决 Adreno Vulkan 驱动 0800.60 在 Android 13+ 上的崩溃问题
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{ package }}"
    android:versionCode="{{ version_code }}"
    android:versionName="{{ version_name }}">

    <uses-sdk
        android:minSdkVersion="{{ min_sdk_version }}"
        android:targetSdkVersion="{{ target_sdk_version }}" />

    <!-- 禁用 Vulkan，强制使用 OpenGL ES -->
    <application
        android:label="{{ app_name }}"
        android:icon="@drawable/icon"
        android:hardwareAccelerated="false"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        
        <!-- 【OPPO/一加/真我专用】禁用游戏优化（会强制启用 Vulkan） -->
        <meta-data
            android:name="com.oppo.game.app_opt"
            android:value="0" />
        
        <meta-data
            android:name="android.app.opa_game_opt"
            android:value="0" />
        
        <!-- 禁用 ColorOS 游戏引擎 -->
        <meta-data
            android:name="com.coloros.gamengine"
            android:value="0" />
        
        <!-- 强制使用 OpenGL 渲染，彻底禁用 Vulkan/硬件加速 -->
        <meta-data
            android:name="android.graphics.enableVulkan"
            android:value="false" />
        
        <!-- 使用 OpenGL 渲染器 -->
        <meta-data
            android:name="debug.hwui.renderer"
            android:value="opengl" />
        
        <activity
            android:name="org.kivy.android.PythonActivity"
            android:label="{{ app_name }}"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|keyboard"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:hardwareAccelerated="false">
            
            <!-- 禁用硬件渲染 -->
            <meta-data
                android:name="debug.hwui.renderer"
                android:value="opengl" />
            
            <meta-data
                android:name="android.max_aspect"
                android:value="2.1" />
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!-- 明确声明仅使用 OpenGL ES 2.0，排除 Vulkan -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    
    <!-- 排除 Vulkan 支持 -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />
    
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false" />

</manifest>
